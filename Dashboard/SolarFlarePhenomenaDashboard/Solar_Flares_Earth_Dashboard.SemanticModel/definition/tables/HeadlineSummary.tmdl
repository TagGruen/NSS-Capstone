	partition HeadlineSummary = m
		mode: import
		source =
				let
					Source = #table(
						type table [Phenomenon = text, SolarMeasure = text, BestLagDays = Int64.Type, PearsonR = number, FDRP = number, Significant = text, Interpretation = text],
						{
							{"Earthquakes", "Flare count (M6+)", 3, -0.043994, 0.061771, "No", "No robust association"},
							{"Volcanic eruptions", "Flare energy", 4, -0.017973, 0.954012, "No", "Essentially no association"},
							{"Precipitation anomaly", "M-class flares", 7, 0.063654, 0.00117, "Yes", "Small significant positive association"},
							{"Temperature anomaly", "M-class flares", 0, -0.034223, 0.500697, "No", "No short-term association"}
