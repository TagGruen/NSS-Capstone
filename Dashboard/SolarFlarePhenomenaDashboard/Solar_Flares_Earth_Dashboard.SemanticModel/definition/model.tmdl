model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["EarthquakeLags","HeadlineSummary","PrecipitationLags","Summary","TemperatureLags","VolcanoLags"]

annotation PBI_ProTooling = ["DevMode"]

ref table EarthquakeLags
ref table HeadlineSummary
ref table PrecipitationLags
ref table Summary
ref table TemperatureLags
ref table VolcanoLags

